# Copy to .env and start the backend with: uvicorn backend.app:app --env-file .env
# Leave CUBEMASTER_LLM_API_KEY empty to use the offline template coach.

# Any OpenAI-compatible /chat/completions endpoint (OpenAI, DeepSeek, Qwen/DashScope, Ollama, LM Studio ...)
CUBEMASTER_LLM_BASE_URL=https://api.openai.com/v1
CUBEMASTER_LLM_API_KEY=
CUBEMASTER_LLM_MODEL=gpt-4o-mini
CUBEMASTER_LLM_TIMEOUT=20

# 1 = pre-solve all <R,U,L> pair states in a background thread at startup (~30 s CPU)
CUBEMASTER_WARM_CACHE=0

CUBEMASTER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
